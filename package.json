{
  "name": "codeql-sarif-security-standard-annotator",
  "version": "v1.1.0",
  "private": true,
  "description": "Compare a CodeQL SARIF results file to a security standard CWE list and annotate the SARIF rules with a tag to highlight results applicable to the security standard",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "release": "release-it",
    "all": "npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advanced-security/codeql-sarif-security-standard-annotator"
  },
  "keywords": [
    "actions",
    "sarif",
    "cwe",
    "codeql",
    "github"
  ],
  "author": "GitHub, Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "jsonpath-plus": "^11.1.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.12.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.16.11",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.3",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0"
  },
  "overrides": {
    "undici": "6.24.0"
  }
}
